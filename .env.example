APP_NAME="E-GOTO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Rotasi harian, bukan satu berkas yang tumbuh tanpa batas. Tanpa ini
# LOG_STACK jatuh ke `single` dan storage/logs/laravel.log membengkak sampai
# kuota shared hosting habis — dan yang habis lebih dulu biasanya kuota, bukan
# kesabaran.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=egoto
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync, bukan database: shared hosting tidak punya worker daemon (PLAN.md §2).
# Job yang di-dispatch ke driver database akan mengantre selamanya tanpa pernah jalan.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login Google (Socialite). Didaftarkan manual — lihat docs/oauth-setup-guide.md.
# Selama kosong, tombol "Masuk dengan Google" otomatis disembunyikan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Booking & pembayaran (lihat config/booking.php). Kosong = pakai default.
BOOKING_EXPIRY_MINUTES=120
ADMIN_WHATSAPP=6281234567890
QRIS_IMAGE_PATH=images/qris-placeholder.svg

# String EMVCo hasil memindai QRIS merchant (diawali 000201...). Isi sekali,
# pakai aplikasi pembaca QR biasa. Kalau terisi, halaman bayar mengunci nominal
# booking ke dalam QR sehingga pembayar tidak perlu mengetik angka sendiri.
# Kosong = halaman bayar memakai gambar QRIS statis seperti sebelumnya.
QRIS_STATIC_PAYLOAD=

# BACKUP_PATH= (kosongkan = storage/app/backups; isi hanya kalau mau di luar folder project)
BACKUP_KEEP_DAYS=14
# XAMPP Windows: C:\xampp\mysql\bin\mysqldump.exe. Hostinger: sudah di PATH.
MYSQLDUMP_BINARY=mysqldump

# CSP ditegakkan (bukan Report-Only) hanya setelah panel admin, panel vendor,
# dan alur booking-bayar-tiket dibuka sekali dengan console browser terbuka
# tanpa sisa pelanggaran.
SECURITY_CSP_ENFORCE=false
